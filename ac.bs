        "items": [
          {
            "id": "section-scoping",
            "name": "Section Scoping",
            "deps": ["heading-parser"]
          },
          {
            "id": "collision-resolution",
            "name": "Collision Resolution",
            "deps": ["id-registry"]
          },
          {
            "id": "include-detection",
            "name": "Include Detection",
            "deps": ["directive-parser"]
          },
          {
            "id": "attribute-parsing",
            "name": "Attribute Parsing",
            "deps": ["reference-parser"]
          }
        ]
      },
      {
        "id": "foundation",
        "title": "Foundation",
        "items": [
          {
            "id": "heading-parser",
            "name": "Heading Parser",
            "deps": []
          },
          {
            "id": "directive-parser",
            "name": "Directive Parser",
            "deps": []
          },
          {
            "id": "reference-parser",
            "name": "Reference Parser",
            "deps": []
          },
          {
            "id": "id-registry",
            "name": "ID Registry",
            "deps": []
          },
          {
            "id": "option-metadata",
            "name": "Option Metadata",
            "deps": []
          }
        ]
      }
    ]
  }
